# AI — prefer OpenClaw when running on this machine (no Cursor key required)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
# from ~/.openclaw/openclaw.json → gateway.auth.token
OPENCLAW_GATEWAY_TOKEN=
# Any OpenAI-compatible endpoint may be used instead of OpenClaw.
# Example local gateway: http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_PROVIDER=openclaw
AI_ALLOW_CURSOR_FALLBACK=false
# Required only for a deliberately trusted hosted endpoint.
AI_ALLOW_REMOTE=false
# Optional: raise gateway agents.defaults.maxConcurrent (default ~4) for multi-user
AI_RUNTIME=openclaw

# Auth
AUTH_SECRET=replace-with-openssl-rand-hex-32
AUTH_DEV_LOGIN=1
# Seeds password hash for ayubshaik642@gmail.com (never commit real value)
AUTH_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3060

# Cross-product links
NEXT_PUBLIC_MPI_URL=https://mpi.tomorrowtools.dev
NEXT_PUBLIC_RESUME_URL=https://resume.tomorrowtools.dev

# Production:
# NEXTAUTH_URL=https://resume.tomorrowtools.dev
# AUTH_URL=https://resume.tomorrowtools.dev

# Google Drive: per-user OAuth (no shared refresh token).
# In Google Cloud Console for the resume OAuth client:
#   1) Enable "Google Drive API"
#   2) Authorized redirect URIs must include:
#        https://resume.tomorrowtools.dev/api/auth/callback/google
#        https://resume.tomorrowtools.dev/api/drive/callback
#      (and http://127.0.0.1:3060 equivalents for local)
# Do NOT point NEXTAUTH_URL/AUTH_URL at mpi.tomorrowtools.dev — that sends
# Google sign-in from the resume app to MPI.
