# AI — prefer OpenClaw when running on this machine (no Cursor key required)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
OPENCLAW_BASE_URL=http://127.0.0.1:18789/v1
# from ~/.openclaw/openclaw.json → gateway.auth.token
OPENCLAW_GATEWAY_TOKEN=
# Any OpenAI-compatible endpoint may be used instead of OpenClaw.
# Example local gateway: http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional faster/cheaper model for draft-style calls (runConfiguredAi({ fast: true }))
AI_MODEL_FAST=
AI_PROVIDER=openclaw
AI_ALLOW_CURSOR_FALLBACK=false
# Required only for a deliberately trusted hosted endpoint.
AI_ALLOW_REMOTE=false
# Max concurrent AI jobs per user / across all users on this Node process
AI_USER_MAX_INFLIGHT=1
AI_GLOBAL_MAX_INFLIGHT=8
# Optional: raise gateway agents.defaults.maxConcurrent (default ~4) for multi-user
AI_RUNTIME=openclaw

# Auth
AUTH_SECRET=replace-with-openssl-rand-hex-32
# Required in production: 64-char hex (openssl rand -hex 32) or passphrase.
# Encrypts SQLite files at rest (SQLCipher-class via better-sqlite3-multiple-ciphers).
# Losing this key loses access to the DB — back it up offline.
DATA_AT_REST_KEY=
AUTH_DEV_LOGIN=1
# Seeds password hash for ayubshaik642@gmail.com (never commit real value)
AUTH_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth consent screen App name is what Google shows (“Continue to …”).
# Rename AesthetIQ → “RocketCV” (or a shared “TomorrowTools”).
# Authorized JavaScript origins:
#   https://resume.tomorrowtools.dev
#   http://127.0.0.1:3060
# Authorized redirect URIs:
#   https://resume.tomorrowtools.dev/api/auth/callback/google
#   http://127.0.0.1:3060/api/auth/callback/google
# Android Custom Tab / Play: same web client +
#   https://resume.tomorrowtools.dev/api/auth/mobile/bridge
# Optional extra host if you add DNS later:
#   https://rocketcv.tomorrowtools.dev
#   https://rocketcv.tomorrowtools.dev/api/auth/callback/google
# Shared invite list with MPI and Commander (plaintext sqlite, chmod 600)
# AUTH_ALLOWLIST_DB=/home/shaik/Desktop/tomorrowtools-shared/allowlist.sqlite
# AUTH_ALLOWLIST_KEY=   # only needed to decrypt a legacy encrypted shared file
NEXTAUTH_URL=http://127.0.0.1:3060

# Cross-product links
NEXT_PUBLIC_MPI_URL=https://mpi.tomorrowtools.dev
NEXT_PUBLIC_RESUME_URL=https://resume.tomorrowtools.dev

# Production:
# NEXTAUTH_URL=https://resume.tomorrowtools.dev
# AUTH_URL=https://resume.tomorrowtools.dev

# Google Drive: per-user OAuth (no shared refresh token).
# In Google Cloud Console for the resume OAuth client:
#   1) Enable "Google Drive API"
#   2) Authorized redirect URIs must include:
#        https://resume.tomorrowtools.dev/api/auth/callback/google
#        https://resume.tomorrowtools.dev/api/drive/callback
#      (and http://127.0.0.1:3060 equivalents for local)
# Do NOT point NEXTAUTH_URL/AUTH_URL at mpi.tomorrowtools.dev — that sends
# Google sign-in from the resume app to MPI.
